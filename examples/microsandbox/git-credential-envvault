#!/usr/local/bin/node
// Public metadata only. A real token is never returned to Git or stored here.
const fs = require('node:fs');
const input = Object.fromEntries(fs.readFileSync(0, 'utf8').split('\n').filter(line => line.includes('=')).map(line => [line.slice(0, line.indexOf('=')), line.slice(line.indexOf('=') + 1)]));
if (process.argv[2] !== 'get' || input.protocol !== 'https' || !['github.com', 'github.com:443'].includes(input.host) || !input.path) process.exit(0);
try {
  const catalog = JSON.parse(fs.readFileSync(process.env.ENVVAULT_CREDENTIALS_FILE || '/etc/envvault/credentials.json', 'utf8'));
  const target = '/' + input.path.replace(/^\/+/, '').replace(/\/+$/, '') + '/info/refs';
  const references = [...new Set((catalog.routes || []).filter(route => route.host === 'github.com' && route.methods.includes('GET') && route.paths.includes(target)).map(route => route.ref))];
  if (references.length === 1 && /^envvault:\/\/[^\r\n\0]+$/.test(references[0])) process.stdout.write('username=x-access-token\npassword=' + references[0] + '\n\n');
} catch {
  process.stderr.write('EnvVault public credential catalog unavailable\n');
  process.exitCode = 1;
}
